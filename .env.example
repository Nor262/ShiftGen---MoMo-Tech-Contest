# === Database ===
# Local SQLite (default for dev & tests)
DATABASE_URL="file:./dev.db"
# For PostgreSQL production / Docker / Vercel / Supabase / Neon:
# DATABASE_URL="postgresql://trustloop:trustloop@localhost:5432/trustloop?schema=public"
# Direct (non-pooled) PostgreSQL URL for Prisma schema push / migrations (Supabase / Neon):
# DIRECT_URL="postgresql://trustloop:trustloop@localhost:5432/trustloop?schema=public"

# === LLM Provider Adapter (Cloud & LLM-Agnostic) ===
# Supported values: gemini | openai | bedrock
# Q48: Bedrock (AWS sponsor credits) first, Gemini as fallback when Bedrock is unavailable.
LLM_BACKEND="bedrock"
LLM_FALLBACK_BACKEND="gemini"
DAILY_LLM_CALL_LIMIT="100"
# Per-call LLM timeout and per-agent War-Room timeout (ms). Slow free-tier models need ~45s.
LLM_TIMEOUT_MS="45000"
WARROOM_AGENT_TIMEOUT_MS="45000"

# --- Option A: Google Gemini REST API ---
GEMINI_API_KEY=""
# Verified 2026-11-23 on the free tier: vision reads the CASE-01 screenshot correctly; 2.5-* models return 404.
# Free-tier quotas are tight (3 Flash: 5 RPM / 20 RPD); a War-Room run makes ~5 near-simultaneous calls.
GEMINI_VISION_MODEL="gemini-3-flash-preview"
GEMINI_REASONING_MODEL="gemini-3.5-flash-lite"

# --- Option B: OpenAI-Compatible API ---
OPENAI_API_KEY=""
LLM_BASE_URL="https://api.openai.com/v1"
LLM_API_KEY=""
LLM_VISION_MODEL="gpt-4o-mini"
LLM_REASONING_MODEL="gpt-4o-mini"

# --- Option C: AWS Bedrock (contest account region: ap-southeast-2 Sydney) ---
# Temporary credentials need all three of KEY_ID / SECRET / SESSION_TOKEN. Never commit real values.
# Model IDs below are defaults pending confirmation against the organizer usage guide.
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
BEDROCK_REGION="ap-southeast-2"
BEDROCK_VISION_MODEL="apac.amazon.nova-pro-v1:0"
BEDROCK_REASONING_MODEL="apac.anthropic.claude-sonnet-4-20250514-v1:0"
BEDROCK_GUARDRAIL_ID=""
BEDROCK_GUARDRAIL_VERSION=""

# === Rate Limiting (IP sliding window for AI endpoints) ===
RATE_LIMIT_MAX_REQUESTS="30"
RATE_LIMIT_WINDOW_MS="600000"
