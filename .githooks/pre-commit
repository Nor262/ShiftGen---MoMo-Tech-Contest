#!/usr/bin/env bash
set -euo pipefail

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

# 1. Block forbidden filenames (.env except .env.example, private key files)
while IFS= read -r file; do
  [ -z "$file" ] && continue
  base=$(basename "$file")
  case "$base" in
    .env.example)
      ;;
    .env|.env.*)
      echo "ERROR [pre-commit]: Refusing to commit secret env file: $file" >&2
      exit 1
      ;;
    *.pem|*.key|id_rsa|id_ed25519)
      echo "ERROR [pre-commit]: Refusing to commit private key file: $file" >&2
      exit 1
      ;;
  esac
done <<< "$STAGED_FILES"

# 2. Block secret patterns in staged additions (excluding this hook file)
SECRET_PATTERN='(-----BEGIN ([A-Z ]+ )?PRIVATE KEY-----|AIza[0-9A-Za-z_-]{35}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|ghp_[A-Za-z0-9]{36})'

MATCHES=$(git diff --cached -U0 -- . ':!.githooks/pre-commit' \
  | grep -E '^\+[^+]' \
  | grep -En "$SECRET_PATTERN" || true)

if [ -n "$MATCHES" ]; then
  echo "ERROR [pre-commit]: Potential secret or private key detected in staged changes:" >&2
  echo "$MATCHES" | head -n 5 >&2
  exit 1
fi

exit 0
