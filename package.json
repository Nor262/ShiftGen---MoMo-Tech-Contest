{
  "name": "momo-trustloop",
  "version": "2.0.0",
  "private": true,
  "description": "MoMo TrustLoop v2 — Closed-Loop Anti-Scam, Cybersecurity & Multi-Agent Future Workspace MVP",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "build:postgres": "prisma generate --schema=prisma/schema.postgres.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "DATABASE_URL=file:./dev.db prisma generate && DATABASE_URL=file:./dev.db vitest run",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:generate:postgres": "prisma generate --schema=prisma/schema.postgres.prisma",
    "db:push:postgres": "prisma db push --schema=prisma/schema.postgres.prisma",
    "gen:demo-images": "node demo-assets/render-demo-images.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.780.0",
    "@prisma/client": "^6.6.0",
    "@xyflow/react": "^12.5.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.487.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.0",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
