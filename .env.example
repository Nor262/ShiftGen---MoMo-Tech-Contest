# === Database ===
# Local SQLite (default for dev & tests)
DATABASE_URL="file:./dev.db"
# For PostgreSQL production / Docker / Vercel / Supabase / Neon:
# DATABASE_URL="postgresql://trustloop:trustloop@localhost:5432/trustloop?schema=public"
# Direct (non-pooled) PostgreSQL URL for Prisma schema push / migrations (Supabase / Neon):
# DIRECT_URL="postgresql://trustloop:trustloop@localhost:5432/trustloop?schema=public"

# === LLM Provider Adapter (Cloud & LLM-Agnostic) ===
# Supported values: gemini | openai | bedrock
# Primary: FPT AI Factory via the OpenAI-compatible adapter (Option B). Fallback: Gemini.
# Bedrock (Option C) is wired but blocked until the organizers grant model access (#17).
LLM_BACKEND="openai"
LLM_FALLBACK_BACKEND="gemini"
DAILY_LLM_CALL_LIMIT="100"
# Per-call LLM timeout and per-agent War-Room timeout (ms). A failed primary call is retried on
# the fallback, so primary + fallback must fit the route limits: /api/shield/scan maxDuration=60s,
# /api/warroom/.../investigate maxDuration=120s. Measured FPT latencies: docs/MEASURED_LATENCIES.md.
LLM_TIMEOUT_MS="25000"
WARROOM_AGENT_TIMEOUT_MS="25000"

# --- Option A: Google Gemini REST API ---
GEMINI_API_KEY=""
# Verified 2026-11-23 on the free tier: vision reads the CASE-01 screenshot correctly; 2.5-* models return 404.
# Free-tier quotas are tight (3 Flash: 5 RPM / 20 RPD); a War-Room run makes ~5 near-simultaneous calls.
GEMINI_VISION_MODEL="gemini-3-flash-preview"
GEMINI_REASONING_MODEL="gemini-3.5-flash-lite"

# --- Option B: OpenAI-Compatible API (used for FPT AI Factory Serverless Inference) ---
# FPT: LLM_BACKEND="openai", base URL https://token-api.fpt.ai/v1, key from
# Serverless Inference > API Keys. Verified live 2026-11-23: gemma-4-31B-it reads the CASE-01
# screenshot; Qwen3.8-27B runs all 4 War-Room agents (timings: docs/MEASURED_LATENCIES.md). Models prefixed
# "Alibaba:", "Azure:", "Google:" are proxied abroad and need a wallet balance.
# Data-centre location is not documented by FPT; confirm before claiming in-country processing.
# Put the FPT key in LLM_API_KEY and leave OPENAI_API_KEY empty: when set, OPENAI_API_KEY wins.
OPENAI_API_KEY=""
LLM_BASE_URL="https://token-api.fpt.ai/v1"
LLM_API_KEY=""
LLM_VISION_MODEL="gemma-4-31B-it"
LLM_REASONING_MODEL="Qwen3.8-27B"

# --- Option C: AWS Bedrock (contest account region: ap-southeast-2 Sydney) ---
# Temporary credentials need all three of KEY_ID / SECRET / SESSION_TOKEN. Never commit real values.
# Model IDs below are defaults pending confirmation against the organizer usage guide.
AWS_REGION="ap-southeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""
BEDROCK_REGION="ap-southeast-2"
BEDROCK_VISION_MODEL="apac.amazon.nova-pro-v1:0"
BEDROCK_REASONING_MODEL="apac.anthropic.claude-sonnet-4-20250514-v1:0"
BEDROCK_GUARDRAIL_ID=""
BEDROCK_GUARDRAIL_VERSION=""

# === Rate Limiting (IP sliding window for AI endpoints) ===
RATE_LIMIT_MAX_REQUESTS="30"
RATE_LIMIT_WINDOW_MS="600000"
